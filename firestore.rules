rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function adminDoc(){ return get(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isAdmin(){ return signedIn() && adminDoc().data.active == true && adminDoc().data.role in ['admin','super_admin']; }
    function isSuperAdmin(){ return isAdmin() && adminDoc().data.role == 'super_admin'; }
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isSuperAdmin();
    }
    match /places/{placeId} {
      function validPublicCounterUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return request.auth == null
          && request.resource.data.views >= 0
          && request.resource.data.favoriteCount >= 0
          && request.resource.data.whatsappClicks >= 0
          && request.resource.data.directionClicks >= 0
          && (
            (changed.hasOnly(['views']) && request.resource.data.views == resource.data.views + 1)
            || (changed.hasOnly(['whatsappClicks']) && request.resource.data.whatsappClicks == resource.data.whatsappClicks + 1)
            || (changed.hasOnly(['directionClicks']) && request.resource.data.directionClicks == resource.data.directionClicks + 1)
            || (changed.hasOnly(['favoriteCount']) && (
              request.resource.data.favoriteCount == resource.data.favoriteCount + 1
              || request.resource.data.favoriteCount == resource.data.favoriteCount - 1
            ))
          );
      }
      allow get, list: if resource.data.status == 'active' || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || validPublicCounterUpdate();
      allow delete: if isSuperAdmin();

      match /favorites/{visitorId} {
        allow get: if true;
        allow list: if false;
        allow create: if request.auth == null
          && request.resource.data.keys().hasOnly(['visitorId','createdAt'])
          && request.resource.data.visitorId == visitorId
          && getAfter(/databases/$(database)/documents/places/$(placeId)).data.favoriteCount
            == get(/databases/$(database)/documents/places/$(placeId)).data.favoriteCount + 1;
        allow delete: if request.auth == null
          && get(/databases/$(database)/documents/places/$(placeId)).data.favoriteCount > 0
          && getAfter(/databases/$(database)/documents/places/$(placeId)).data.favoriteCount
            == get(/databases/$(database)/documents/places/$(placeId)).data.favoriteCount - 1;
        allow update: if false;
      }
    }
    match /place_submissions/{submissionId} {
      allow create: if request.auth == null
        && request.resource.data.status == 'pending'
        && request.resource.data.verificationStatus == 'unverified'
        && request.resource.data.ownershipStatus == 'unclaimed'
        && request.resource.data.plan == 'free'
        && request.resource.data.featured == false
        && request.resource.data.submissionCode is string
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.keys().hasOnly([
          'name','categoryId','description','priceMin','priceMax','serviceTypes','halalStatus',
          'province','regencyType','regency','district','village','address','latitude','longitude',
          'whatsapp','phone','instagram','tiktok','facebook','submitterName','submitterWhatsapp',
          'openingHours','coverImage','images','status','verificationStatus','ownershipStatus',
          'plan','featured','createdAt','submissionCode'
        ]);
      allow read, update: if isAdmin();
      allow delete: if isSuperAdmin();

      match /products/{productId} {
        allow create: if request.auth == null
          && getAfter(/databases/$(database)/documents/place_submissions/$(submissionId)).data.status == 'pending'
          && request.resource.data.keys().hasOnly([
            'name','category','description','price','imageUrl','available','bestseller','preorder','order','createdAt'
          ])
          && request.resource.data.keys().hasAll(['name','price','available','bestseller','preorder','order','createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.price is number
          && request.resource.data.price > 0
          && request.resource.data.available is bool
          && request.resource.data.bestseller is bool
          && request.resource.data.preorder is bool
          && request.resource.data.order is int
          && request.resource.data.order >= 0
          && request.resource.data.order < 10;
        allow read, update: if isAdmin();
        allow delete: if isSuperAdmin();
      }
    }
    match /analytics_daily/{dateKey} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['date','visits','uniqueSessions','updatedAt'])
        && request.resource.data.date == dateKey
        && request.resource.data.visits == 1
        && request.resource.data.uniqueSessions == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visits','uniqueSessions','updatedAt'])
        && request.resource.data.date == resource.data.date
        && request.resource.data.visits == resource.data.visits + 1
        && request.resource.data.uniqueSessions == resource.data.uniqueSessions + 1;
      allow delete: if isSuperAdmin();
    }    match /submission_status_public/{submissionCode} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth == null
        && request.resource.data.keys().hasOnly(['submissionCode','name','status','updatedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.submissionCode == submissionCode;
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }
  }
}