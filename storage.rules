rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin(){ return request.auth != null && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true; }
    match /place-submissions/{submissionId}/{fileName} {
      allow read: if isAdmin();
      allow create: if request.auth == null && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if isAdmin();
    }
    match /places/{placeId}/{fileName} { allow read: if true; allow write: if isAdmin(); }
  }
}